<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true"
    android:padding="32dp">``

    <ImageView
        android:id="@+id/imgNfcIcon"
        android:layout_width="232dp"
        android:layout_height="243dp"
        android:src="@drawable/ic_nfc"
        android:tint="@android:color/white"
        app:layout_constraintBottom_toTopOf="@+id/txtTitulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Listo para explorar!"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/imgNfcIcon"
        app:layout_constraintBottom_toTopOf="@+id/txtSubtitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="342dp"
        android:layout_height="142dp"
        android:layout_marginTop="16dp"
        android:text="Acerque su dispositivo a la etiqueta interactiva para desbloquear información exclusiva."
        android:textAlignment="center"
        android:textColor="#E0E0E0"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@+id/btnCancelarNFC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo" />

    <Button
        android:id="@+id/btnCancelarNFC"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="CANCELAR"
        android:textColor="@android:color/white"
        android:backgroundTint="#33FFFFFF"
        android:textAllCaps="true"
        android:textStyle="bold"
        app:cornerRadius="30dp"
        android:layout_marginBottom="40dp"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>